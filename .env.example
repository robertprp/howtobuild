# Copy to .env only if you do not already have one. Never commit real credentials.
# VITE_* values are public and embedded at build time: never put secrets in them.
# Configure production variables in your hosting provider; rebuild for VITE_* changes.
# Migrations are explicit: pnpm db:migrate (against your intended existing database).

# APPLICATION — required for authentication and database-backed features.
# Use your HTTPS application origin in production.
BETTER_AUTH_URL=http://localhost:3000
# Generate a unique secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Existing Postgres connection. Replace every placeholder; never share the real URL.
# For Supabase, use the appropriate session/transaction pooler for your runtime.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_POOL_MAX=5

# SEARCH VISIBILITY — enable only for the canonical production deployment.
# Development pages are always noindex. Keep forks/staging builds false.
# Canonicals currently use howtobuild.dev in src/lib/seo.ts; changing the auth
# origin does not change the site's search identity.
VITE_SITE_INDEXABLE=false
# Optional public Google Search Console HTML verification token.
VITE_GOOGLE_SITE_VERIFICATION=

# SIGN-IN — configure at least one provider to allow registration.
# GitHub/Google are enabled only when both their ID and secret are provided.
# Register callbacks under BETTER_AUTH_URL:
# /api/auth/callback/github and /api/auth/callback/google
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Email-code sign-in needs Resend and a sender on your verified sending domain.
RESEND_API_KEY=
EMAIL_FROM=HowToBuild.dev <auth@example.com>
# Public registration does not grant admin access. After registering and verifying:
# pnpm admin:grant --email you@example.com

# CONTRIBUTION PROTECTION — server-only secrets and proxy configuration.
# Generate a separate secret with: openssl rand -base64 32
# If blank, the application falls back to BETTER_AUTH_SECRET.
CONTRIBUTION_HASH_SECRET=
# Your production proxy MUST overwrite this header with the real client IP.
# Never trust a header clients can supply unchanged; adapt to your hosting proxy.
TRUSTED_CLIENT_IP_HEADER=x-forwarded-for

# GITHUB COLLECTION / SCHEDULED JOBS — optional unless running these features.
# GitHub API token for repository collection; separate from the OAuth client secret.
GITHUB_TOKEN=
# Optional owner/repository filter for the CLI collector, not the scheduled job.
GITHUB_REPOSITORY=
# Generate with: openssl rand -base64 32. Protects scheduled-job endpoints.
CRON_SECRET=
# Comma-separated exact hostnames for published-link checks; no wildcards.
# Leave empty to disable link monitoring. Apply existing migrations before use.
LINK_CHECK_ALLOWED_HOSTS=

# IMAGE UPLOADS — optional Supabase Storage configuration for the asset pipeline.
SUPABASE_URL=
# Server-only privileged key. Never prefix with VITE_ or expose in browser code.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ASSET_BUCKET=images

# ANALYTICS — optional; leave blank/false to keep these integrations disabled.
# External script URL and its public data-website-id (Umami-compatible).
# Review the provider's collection behavior and update your privacy disclosures.
VITE_ANALYTICS_SCRIPT_URL=
VITE_ANALYTICS_SITE_ID=
# Aggregate first-party product events require BOTH flags to be true.
# Configure log retention/export and review privacy before enabling; rebuild client.
# These flags do not control the separate browser-error / Web Vitals telemetry.
VITE_PRODUCT_ANALYTICS_ENABLED=false
PRODUCT_ANALYTICS_ENABLED=false

# SPONSORSHIP — optional public contact inbox. Empty keeps booking closed.
VITE_SPONSOR_CONTACT_EMAIL=

# OBSERVABILITY — optional server-side telemetry forwarding.
# For Better Stack: https://<your-ingesting-host>.betterstackdata.com
# Use the source token without a Bearer prefix. Never use a VITE_ variable for it.
# Empty URL uses server console output instead of forwarding.
# Verify the configured connection with: pnpm telemetry:check
OBSERVABILITY_INGEST_URL=
OBSERVABILITY_INGEST_TOKEN=
