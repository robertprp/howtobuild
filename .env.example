# Public origin used for Better Auth callbacks and canonical links.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=REMOVED_EXPOSED_SECRET
DATABASE_URL=

# Phase 0 auth providers.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend is the selected transactional email provider.
RESEND_API_KEY=REMOVED_EXPOSED_SECRET
EMAIL_FROM=HowToBuild.dev <auth@example.com>

# Scheduled GitHub collector.
GITHUB_TOKEN=REMOVED_EXPOSED_SECRET
GITHUB_REPOSITORY=tanstack/router
CRON_SECRET=REMOVED_EXPOSED_SECRET

# Supabase Storage is the selected image host.
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ASSET_BUCKET=images
