# Public origin used for Better Auth callbacks and canonical links.
BETTER_AUTH_URL=http://localhost:3000
SITE_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

# Supabase Postgres Supavisor transaction-pool connection string.
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@REGION.pooler.supabase.com:6543/postgres?sslmode=require


# Phase 0 auth providers.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend is the selected transactional email provider.
RESEND_API_KEY=
EMAIL_FROM=HowToBuild.dev <auth@example.com>

# Scheduled GitHub collector.
GITHUB_TOKEN=
# Optional: limits the CLI script to one owner/name coordinate. The scheduled
# job always collects every active catalog repository serially.
GITHUB_REPOSITORY=
CRON_SECRET=

# Supabase Storage is the selected image host.
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ASSET_BUCKET=images
